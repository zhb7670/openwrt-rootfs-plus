#!/bin/sh
# 给 ifit 主题补上 iStore 顶层菜单的图标与缩进。
#
# 【为什么需要】
#   luci-app-store 用 entry({"admin","store"}, ...) 注册菜单，它是整个侧边栏里
#   唯一"没有子菜单的顶层项"。ifit 的 render_topmenu() 对这种项输出裸
#   <li><a data-title="iStore" href="...">，不继承 .nav > .slide > a 的样式；
#   而 ifit 的图标是"按 data-title 硬编码"在 style.css 里的，表里恰好没有
#   iStore 这一条 → 结果就是无图标 + 文字贴最左边。
#
# 【本脚本做什么】
#   照抄主题中 Logout 的同款写法，往 style.css 末尾追加 iStore 的
#   padding-left / line-height 与 :before 图标（\e903 = icomoon "extension"）。
#   幂等：已打过补丁就直接退出。
#
# 【回滚】删掉 style.css 里 "固件定制补丁" 那一段即可。

C=/www/luci-static/ifit/css/style.css

[ -f "$C" ] || exit 0
grep -q 'data-title="iStore"' "$C" && exit 0

cat >> "$C" <<'CSS_PATCH_EOF'

/* ==================== 固件定制补丁：iStore 菜单图标 ==================== */
.main > .main-left > .nav > li > a[data-title="iStore"] {
    padding-left: 36px;
    line-height: 40px;
}

.main > .main-left > .nav > li > a[data-title="iStore"]:before {
    content: "\e903";
    color: #26C6DA !important;
    display: inline-block;
    top: -1px;
    left: -10px;
    position: relative;
    vertical-align: middle;
    font-family: "HomeLedeIcomoon" !important;
    font-style: normal !important;
    font-weight: normal !important;
    font-variant: normal !important;
    text-transform: none !important;
    speak: none;
    line-height: 1;
    -webkit-font-smoothing: antialiased;
    border-radius: 50%;
    background-color: transparent;
}

.main > .main-left > .nav > li > a[data-title="iStore"]:hover {
    color: #ff8534;
}
/* ================== 固件定制补丁结束 ================== */
CSS_PATCH_EOF

exit 0
